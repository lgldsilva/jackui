port: 8989
jackett:
  url: http://localhost:9117
  api_key: YOUR_API_KEY_HERE

download_clients:
  # qBittorrent credentials ship EMPTY on purpose — fill in your credentials
  # below (never commit them). Do not rely on the qBittorrent well-known
  # admin/adminadmin default.
  - id: qbit-local
    name: "qBittorrent Local"
    type: qbittorrent
    url: http://localhost:8080
    username: ""
    password: ""
    default: true
  - id: qbit-remote
    name: "qBittorrent Remote"
    type: qbittorrent
    url: http://your-server-ip:8080
    username: ""
    password: ""
    default: false
  - id: transmission-local
    name: "Transmission Local"
    type: transmission
    url: http://localhost:9091
    username: ""
    password: ""
    default: false

# AI title identification (OPTIONAL). Usually exporting the keys via env is enough
# (GROQ_API_KEY / OPENROUTER_API_KEY / OPENCODE_API_KEY / GEMINI_API_KEY / OLLAMA_BASE_URL):
# the chain is auto-seeded and the benchmark reorders it by score. The section below is only
# needed to OVERRIDE the default model choices (they have defaults in code):
# ai:
#   providers:
#     groq:
#       # preferred_models: preference order for this provider's default pick (the chain's
#       # ORDER still comes from the benchmark; this only decides WHICH model the provider offers).
#       preferred_models: [llama-3.1-8b-instant, llama-3.3-70b-versatile]
#     ollama:
#       preferred_models: [llama3.1:8b, gemma3:4b]
#     google:
#       # free_models: fixed list of Gemini FREE ids (Google's /models does not expose pricing).
#       # Update here when Google changes the free tier — never include paid models (pro/3.5).
#       free_models: [gemini-2.5-flash-lite, gemini-2.5-flash]
#   max_cost_per_1m: 0        # 0 = benchmark only tests/adopts free models
