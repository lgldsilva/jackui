# syntax=docker/dockerfile:1.7
#
# Reproducible, glibc-based CI image. A remote Docker context cannot safely
# bind-mount the runner's tree. Digest for node:24.19.0-bookworm-slim.
FROM node@sha256:f5d1cc40abc10c2843339a2134d07817cf33c405cb16bfd052b0ed790254c3a3 AS node

# Digest for golang:1.26.7-bookworm.
FROM golang@sha256:6ef6e30f0ea5c384f6d111cf856e024e3086bbdcb1779da3f3b3fbba0aea53d2

ARG GOLANGCI_LINT_VERSION=v2.13.1
ARG NPM_VERSION=12.0.2
ARG NPM_BRACE_EXPANSION_VERSION=5.0.9
ARG NPM_IP_ADDRESS_VERSION=10.3.1
ARG NPM_TAR_VERSION=7.5.21

ENV DEBIAN_FRONTEND=noninteractive \
    GOTOOLCHAIN=local \
    CI=true

# The base images above are immutable. Debian package revision pins are avoided
# deliberately so the Bookworm security mirror can supply current fixes on every
# ephemeral rebuild; this image is never shipped. The shipped production image
# is the one gated by a vulnerability scan (release.yml, Trivy CRITICAL).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        libaprutil1 \
        make \
    && rm -rf /var/lib/apt/lists/*

# Copy the pinned Node distribution instead of trusting a mutable apt channel.
# Install exact npm and golangci-lint releases without dependency lifecycle
# scripts; the Go module version pins the linter's authoritative module graph.
COPY --from=node /usr/local /usr/local
RUN set -eux; \
    npm install --global --ignore-scripts "npm@${NPM_VERSION}"; \
    npm install --prefix /tmp/npm-security-patches --ignore-scripts --no-save \
        "brace-expansion@${NPM_BRACE_EXPANSION_VERSION}" \
        "ip-address@${NPM_IP_ADDRESS_VERSION}" \
        "tar@${NPM_TAR_VERSION}"; \
    npm_modules=/usr/local/lib/node_modules/npm/node_modules; \
    rm -rf \
        "${npm_modules}/brace-expansion" \
        "${npm_modules}/ip-address" \
        "${npm_modules}/tar"; \
    cp -a /tmp/npm-security-patches/node_modules/brace-expansion "${npm_modules}/brace-expansion"; \
    cp -a /tmp/npm-security-patches/node_modules/ip-address "${npm_modules}/ip-address"; \
    cp -a /tmp/npm-security-patches/node_modules/tar "${npm_modules}/tar"; \
    test \
        "$(node -p "require('${npm_modules}/brace-expansion/package.json').version")" \
        = "${NPM_BRACE_EXPANSION_VERSION}"; \
    test \
        "$(node -p "require('${npm_modules}/ip-address/package.json').version")" \
        = "${NPM_IP_ADDRESS_VERSION}"; \
    test \
        "$(node -p "require('${npm_modules}/tar/package.json').version")" \
        = "${NPM_TAR_VERSION}"; \
    rm -rf /tmp/npm-security-patches; \
    npm --version; \
    attempt=1; \
    until GOBIN=/tmp/golangci-bin go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}"; do \
        attempt=$((attempt + 1)); \
        if [ "${attempt}" -gt 4 ]; then \
            echo "go install golangci-lint failed after 4 attempts" >&2; \
            exit 1; \
        fi; \
        echo "go install failed (proxy.golang.org flake?); retrying in $((attempt * 10))s" >&2; \
        sleep $((attempt * 10)); \
    done; \
    install -m 0755 /tmp/golangci-bin/golangci-lint /usr/local/bin/golangci-lint; \
    rm -rf /tmp/golangci-bin; \
    go version; node --version; npm --version; golangci-lint --version

WORKDIR /workspace
# Copy only inputs required by the CI contract. The host-generated patch is
# explicit, so secrets or unrelated files cannot enter through a broad COPY.
COPY go.mod go.sum .golangci.yml .ci-golangci.patch ./
# Root package.json/package-lock.json + electron/ feed the Electron TypeScript
# check (tsc -p electron/tsconfig.json) in ci-container.sh. electron/dist and
# node_modules stay out via .dockerignore.
COPY package.json package-lock.json ./
COPY cmd ./cmd
COPY internal ./internal
COPY ui ./ui
COPY web ./web
COPY electron ./electron
COPY scripts/ci-container.sh ./scripts/ci-container.sh

ENTRYPOINT ["/workspace/scripts/ci-container.sh"]
